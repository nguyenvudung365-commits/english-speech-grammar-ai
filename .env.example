# Example placeholders only; use scripts/setup-local.ps1 to generate a local password.
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql+psycopg://speech:replace-with-random-local-password@127.0.0.1:55439/speech
ORIGIN=http://127.0.0.1:8000
STORAGE_ROOT=data/private-audio
COOKIE_SECURE=false
QUEUE_GLOBAL=32
QUEUE_PER_USER=4
ADAPTER_BACKEND=fake
# Real models (only with ADAPTER_BACKEND=real; the worker refuses to start otherwise).
# Local directories made by the commands in README; REVISION = Hugging Face commit hash, for provenance.
ASR_MODEL=
ASR_REVISION=
GRAMMAR_MODEL=
GRAMMAR_REVISION=
